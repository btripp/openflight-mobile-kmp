<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenFlight app icon foreground: a gold golf ball on a gold flight-trail arc, from the
  official OpenFlight favicon (https://openflight.dev/icon.svg, fetched 2026-09-24; the
  logo's flattened gold #D4AF37 mark on the palette's #0A0A0F background). The mark is
  recentered and scaled (translate 8.60,12.66 scale 2.7106) so it sits inside the adaptive
  icon's 66dp safe zone regardless of the launcher's mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="8.60"
        android:translateY="12.66"
        android:scaleX="2.7106"
        android:scaleY="2.7106">
        <!-- flight-trail arc -->
        <path
            android:pathData="M4,27 Q15,21 23,11"
            android:fillColor="#00000000"
            android:strokeColor="#D4AF37"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeAlpha="0.55" />
        <!-- golf ball -->
        <path
            android:pathData="M12.5,12 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 Z"
            android:fillColor="#D4AF37" />
        <!-- dimples -->
        <path
            android:fillColor="#9C7E26"
            android:fillAlpha="0.55"
            android:pathData="
                M17.95,9.5 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M21.95,9.8 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M16.35,12.6 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M19.95,12.6 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M23.55,12.9 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M17.95,15.4 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z
                M21.65,15.6 a1.05,1.05 0 1,0 2.1,0 a1.05,1.05 0 1,0 -2.1,0 Z" />
    </group>
</vector>
