<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The Pi serves shots over plain HTTP on the local network. This permits
	     cleartext only for .local names and private address ranges, rather than
	     disabling App Transport Security outright. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenFlight connects to your Raspberry Pi on this network to receive shot data over Wi-Fi.</string>
	<key>NSMotionUsageDescription</key>
	<string>OpenFlight uses motion sensors to measure and calibrate the TI radar mount angle.</string>
	<!-- DM Serif Display (headings) and Outfit (body), the same OFL fonts as Android's
	     core:designsystem; the license texts sit next to them in Fonts/. -->
	<key>UIAppFonts</key>
	<array>
		<string>DMSerifDisplay-Regular.ttf</string>
		<string>Outfit-Variable.ttf</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OpenFlight connects to your launch monitor over Bluetooth to receive shots and change clubs.</string>
</dict>
</plist>
